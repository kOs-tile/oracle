# ── ORACLE Configuration ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# All API keys are optional — ORACLE works without them using free-tier endpoints.

# ── Service ───────────────────────────────────────────────────────────────────
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development   # development | production

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── API Keys ──────────────────────────────────────────────────────────────────
# CoinGecko — free tier works without a key (60 req/min)
# Get one at: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# CryptoPanic — required for crypto news feed
# Get free key at: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# NewsAPI — required for general news headlines
# Get free key at: https://newsapi.org/register
NEWSAPI_KEY=

# Etherscan — required for real gas prices
# Get free key at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ── Refresh Intervals (seconds) ───────────────────────────────────────────────
REFRESH_INTERVAL_CRYPTO=30
REFRESH_INTERVAL_MACRO=900
REFRESH_INTERVAL_NEWS=300
REFRESH_INTERVAL_ONCHAIN=60

# ── WebSocket ─────────────────────────────────────────────────────────────────
WS_PUSH_INTERVAL=10

# ── Tracked Instruments ───────────────────────────────────────────────────────
CRYPTO_TOP_N=20
STOCK_TICKERS=["SPY","NVDA","TSLA"]
MACRO_TICKERS=["DX-Y.NYB","^VIX"]
CRYPTO_TICKERS=["BTC-USD","ETH-USD","SOL-USD"]
